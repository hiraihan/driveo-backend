# ================= DriveO Backend - Environment =================
# Salin file ini menjadi `.env` dan sesuaikan nilainya.

DRIVEO_ENV=dev

# Wajib 32+ karakter untuk penandatanganan JWT
DRIVEO_JWT_SECRET=ganti-dengan-secret-32-karakter-atau-lebih

# Database
#   Dev  : sqlite+aiosqlite:///./dev.db
#   Prod : postgresql+asyncpg://user:pass@host/db
DRIVEO_DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Seed demo data saat server start (hanya non-prod)
DRIVEO_SEED_ON_STARTUP=true
DRIVEO_SEED_ADMIN_PASSWORD=admin12345

# Payment gateway (Midtrans)
DRIVEO_MIDTRANS_SERVER_KEY=dev-midtrans-server-key

# CORS origins (frontend Next.js)
DRIVEO_CORS_ORIGINS=["http://localhost:3000"]